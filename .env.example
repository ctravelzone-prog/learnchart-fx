# Copy to .env.local for local runs. Dev defaults exist in code so the
# project runs with zero config; set real secrets before any launch.
SESSION_SECRET=change-me-to-a-long-random-string
KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string
# Optional: override the SQLite file location.
# DB_PATH=./data/learnchart.db

# Email (SMTP) — needed so Forex students receive their Course Key by
# email. Without these, the site still works, but the key is never sent:
# enrollment completes and the confirmation page says honestly that
# email is not connected yet. Use the site owner's own mail account
# (e.g. a Gmail App Password for SMTP_USER/SMTP_PASS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=LearnChart FX <you@example.com>
