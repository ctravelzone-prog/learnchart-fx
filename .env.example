# Copy to .env.local for local runs. Dev defaults exist in code so the
# project runs with zero config; set real secrets before any launch.
SESSION_SECRET=change-me-to-a-long-random-string
KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string
# Optional: override the SQLite file location.
# DB_PATH=./data/learnchart.db

# Master admin panel (/admin/login). Set these to choose the admin login;
# without them the site seeds a preview-default admin (password handed
# to the site owner separately, never committed). Change it in the panel.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-strong-password

# Email (SMTP) — needed so video-course students receive their Course
# Key by email. WITHOUT these, the site still works, but the key is never
# sent: enrollment completes and the confirmation page says honestly that
# email is not connected yet. These can ALSO be filled in from the admin
# panel (Payment Settings → Email) — the panel wins over env vars, and
# env vars survive a database wipe. Use the site owner's own mail account
# (e.g. a Gmail App Password for SMTP_USER/SMTP_PASS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=LearnChart FX <you@example.com>

# Binance payments (Nov 2026) — BOTH rails are FREE for the owner: no
# merchant application, no paid service. Leave a rail unset and the
# enroll page honestly says "not connected yet" for that option.
# These can ALSO be filled in from the admin panel (Payment Settings) —
# the panel wins over env vars, and env vars survive a database wipe.
# RAIL 1 — BEP20 USDT: students send exactly 250 USDT on BNB Smart
# Chain to this wallet address, then paste the TxHash; the server
# verifies it on-chain. BSCSCAN_API_KEY is the FREE BscScan key
# (optional — without it the public BSC JSON-RPC is used instead).
# BINANCE_BSC_ADDRESS=0xYourBscWalletAddress
# BSCSCAN_API_KEY=YourFreeBscScanApiKey
# RAIL 2a — Binance Pay, PRIMARY (read-only key TxID check): students
# pay your Binance Pay ID and paste the Order ID; the server checks
# YOUR Pay history via GET /sapi/v1/pay/transactions. Create the key
# at Binance → API Management with ONLY "Enable Reading" — never give
# it trade or withdraw permission — and restrict it to the server IP.
# BINANCE_PAY_ID=YourBinancePayId
# BINANCE_API_KEY=YourReadOnlyBinanceApiKey
# BINANCE_API_SECRET=YourReadOnlyBinanceApiSecret
# RAIL 2b — Binance Pay merchant checkout (FUTURE-OPTIONAL ONLY): only
# if you ever apply at merchant.binance.com and get approved. Never
# required for Binance Pay to work — Rail 2a works without it.
# BINANCE_PAY_API_KEY=YourMerchantApiKey
# BINANCE_PAY_SECRET_KEY=YourMerchantSecretKey
# Public base URL of the site (used for the merchant webhook + return
# URL; defaults to the Render preview URL).
# SITE_URL=https://learnchart-fx.onrender.com
